OLLAMA_KEEP_ALIVE=-1
STT_BACKEND=whisper
# optional tweaks:
WHISPER_MODEL=large-v3-turbo  # faster large v3 variant
WHISPER_DEVICE=cuda          # use GPU for speed
WHISPER_COMPUTE_TYPE=float16    # RTX 5060 (sm_120) + ctranslate2 4.6.3 supports only float16/bfloat16/float32 on CUDA; int8* is unsupported
WHISPER_LANGUAGE=en
WHISPER_BEAM_SIZE=1
WHISPER_TEMPERATURE=0.0
WHISPER_PRE_ROLL_MS=240
USER_FRAGMENT_MERGE_SEC=0.6
PREEMPTIVE_STT=1
LIVEKIT_URL=ws://192.168.197.45:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=6f1d0c9b7a34e6c2d8f501c9a4b3e2975c4d8f6a1b2c3d4e5f60718293a0b1c0


OLLAMA_MODEL=gemma4:4b
# gemma4 is a thinking model: with thinking enabled it spends the whole token
# budget in the `thinking` field and returns an empty `content`, so the agent
# never speaks. false = disable thinking; true = enable; auto = omit the flag.
OLLAMA_THINK=false
# OLLAMA_MODEL=qwen
PIPER_EXE=bin/piper.exe
PIPER_MODEL=models/piper/en_US-danny-low.onnx
PIPER_CONFIG=models/piper/en_US-danny-low.onnx.json
# PIPER_MODEL=models/piper/hi_IN-priyamvada-medium.onnx
# PIPER_CONFIG=models/piper/hi_IN-priyamvada-medium.onnx.json


SILERO_ACTIVATION=0.26    # VAD start threshold; lower = more sensitive, catches very short words/letters
SILERO_DEACTIVATION=0.16  # VAD stop threshold; lower keeps listening through tiny breaths/pauses
SILERO_MIN_SPEECH_MS=50   # Minimum speech chunk length (ms); allows single-letter utterances like “A”
SILERO_MIN_SILENCE_MS=350 # Short pause ends the turn
SILERO_PREFIX_PAD_MS=300
SILERO_DEVICE=cpu         # Silero VAD is tiny; CPU is faster than GPU here (no per-chunk GPU round-trip) and frees VRAM for Whisper/Ollama

PIPER_USE_CUDA=0
PIPER_THREADS=6          # or number of physical cores you want to use
PIPER_NOISE_SCALE=0.7
PIPER_LENGTH_SCALE=1.0   # slightly faster speech

# new setting after this///

WHISPER_HPF_HZ=110
WHISPER_TARGET_RMS_DB=-18


CHAT_NUM_PREDICT=200
CHAT_NUM_CTX=2048
CHAT_TEMPERATURE=0.1

# Clinic DOCX system prompt (Shared Agent Prompt) — see src/clinic_prompt.py
# Paths to the two knowledge DOCX files live in configs/clinic_runtime.json.
# CLINIC_NUM_CTX overrides the auto-computed context window (RTX 5060 has 8 GB).
# CLINIC_NUM_CTX=8192


LIVEKIT_INTERNAL_URL=ws://127.0.0.1:7880
VAD_SILENCE_S=0.4
WSVOICE_TLS=1

# Keep the full clinic prompt: this Gemma/Ollama build reserves half the context.
CLINIC_NUM_CTX=49152

# Advertise Ethernet to LAN browsers instead of the Tailscale adapter.
LIVEKIT_NODE_IP=192.168.197.45
