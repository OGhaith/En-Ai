# LiveKit Cloud / LiveKit self-host config
# Put your real values in .env.local. Do NOT commit .env.local.

# Browser-visible LiveKit URL. LiveKit Cloud usually looks like:
# NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud

# Server-side fallback URL used by the Next.js token endpoint.
LIVEKIT_URL=wss://your-project.livekit.cloud

# Token generation credentials from LiveKit Cloud Project Settings -> API Keys.
LIVEKIT_API_KEY=replace_me
LIVEKIT_API_SECRET=replace_me

# Optional: set this only if your Python LiveKit Agent is registered with a fixed agent_name.
# Leave empty if your agent works without a fixed name.
NEXT_PUBLIC_LIVEKIT_AGENT_NAME=
LIVEKIT_AGENT_NAME=

# Optional token/room naming settings.
LIVEKIT_ROOM_PREFIX=voice_assistant_room
LIVEKIT_PARTICIPANT_PREFIX=voice_assistant_user
LIVEKIT_PARTICIPANT_NAME=user
LIVEKIT_TOKEN_TTL=15m

# Optional UI config.
NEXT_PUBLIC_COMPANY_NAME=Voice AI
NEXT_PUBLIC_PAGE_TITLE=Voice AI Assistant
NEXT_PUBLIC_PAGE_DESCRIPTION=Chat live with your voice AI assistant
NEXT_PUBLIC_START_BUTTON_TEXT=Start call
NEXT_PUBLIC_SUPPORTS_CHAT_INPUT=true
NEXT_PUBLIC_SUPPORTS_VIDEO_INPUT=false
NEXT_PUBLIC_SUPPORTS_SCREEN_SHARE=false
NEXT_PUBLIC_PRECONNECT_BUFFER_ENABLED=true

# Internally used optional environment variables
NEXT_PUBLIC_APP_CONFIG_ENDPOINT=
SANDBOX_ID=
